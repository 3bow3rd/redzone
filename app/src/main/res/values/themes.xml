<resources>
    <color name="rz_bg">#070B14</color>
    <style name="Theme.RedZone.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#070B14</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.RedZone</item>
    </style>
    <style name="Theme.RedZone" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/rz_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
